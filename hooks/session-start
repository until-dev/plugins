#!/usr/bin/env bash
# SessionStart hook for the Until plugin — injects the using-until bootstrap as forced context.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# The hook payload on stdin carries the conversation id. Surfacing it in the
# injected context lets the agent quote the EXACT human-run bypass command
# instead of a <conversation_id> placeholder the
# user can't run — the agent has no other way to learn its own session id
# (shell access to ~/.until/state is hard-blocked, even for reads).
HOOK_PAYLOAD="$(cat 2>/dev/null || true)"
convo_id="$(printf '%s' "$HOOK_PAYLOAD" | tr -d '\n' \
  | sed -n 's/.*"conversation_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)"
# Claude Code calls it session_id.
if [ -z "$convo_id" ]; then
  convo_id="$(printf '%s' "$HOOK_PAYLOAD" | tr -d '\n' \
    | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)"
fi

# Read the using-until bootstrap skill.
using_until_content=$(cat "${PLUGIN_ROOT}/skills/using-until/SKILL.md" 2>&1 || echo "Error reading using-until skill")

# Escape a string for JSON embedding using bash parameter substitution (fast, dependency-free).
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_until_escaped=$(escape_for_json "$using_until_content")

gate_id_context=""
if [ -n "$convo_id" ]; then
  if [ "${CURSOR_AGENT:-}" = "1" ]; then
    gate_id_context="\n\n**This session is remote (Cursor Cloud, CURSOR_AGENT=1).** After an explicit Until Loop waiver — closed set: “Don’t use the Until Loop for this.”; “Do not plan”/“DO NOT PLAN” paired with implement or open a PR; “Skip Plan review”; “Don’t use the Until Loop” — quote their words, tell them once that Plan review and the Plan check are waived, write ~/.until/waivers/${convo_id}.json (kind=remote, host=cursor_cloud, quoted, waived plan_review and plan_check, agent_url https://cursor.com/agents/<bcId>), stamp the pull request with the quote, that URL, and that Plan review and the Plan check were skipped, then proceed. Same-machine sessions still require a skip file; this remote session uses the in-chat waiver as proof. Never record a Review verdict. CURSOR_AGENT=1 alone is not a waiver."
  else
    gate_id_context="\n\n**This session is same-machine. Human-run bypass command: touch ~/.until/state/skip-${convo_id}** — use this ONLY after your partner explicitly says “Don’t use the Until Loop for this.” (or another closed-set waiver: “Do not plan”/“DO NOT PLAN” paired with implement or open a PR, “Skip Plan review”, “Don’t use the Until Loop”). Never execute or propose it as a review substitute, sign-off, or an ordinary review path. Quote their instruction, explain once what they waive, then give them this exact command to run in their own terminal. Remote sessions (CURSOR_AGENT=1) use an in-chat waiver instead of this skip file. Never chain it, vary it, create the file yourself, or expose this plumbing otherwise."
  fi
fi

session_context="You have Until.\n\nBelow is the full 'until:using-until' routing guide. For later stages, use the matching skill.\n\n${using_until_escaped}${gate_id_context}"

# Emit the context-injection envelope the current platform expects.
# Cursor: additional_context (snake_case). Claude Code: hookSpecificOutput.additionalContext.
# Copilot/SDK standard: top-level additionalContext.
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context"
fi

exit 0
