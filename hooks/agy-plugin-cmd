#!/bin/sh
# Resolve the installed Until plugin after `agy plugin install`, then exec a
# hook script. Relative hook commands resolve against the launch cwd, which
# is not the plugin directory.
set -eu

hook_name="${1:-}"
if [ -z "$hook_name" ]; then
  exit 0
fi

for root in \
  "${AGY_PLUGIN_ROOT:-}" \
  "${ANTIGRAVITY_PLUGIN_ROOT:-}" \
  "$HOME/.gemini/antigravity-cli/plugins/until" \
  "$HOME/.gemini/config/plugins/until"
do
  [ -n "$root" ] || continue
  script="$root/hooks/$hook_name"
  if [ -x "$script" ]; then
    exec "$script"
  fi
done

exit 0
